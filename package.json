{
  "name": "portfolio-astro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun scripts/fetch-engine.ts",
    "dev": "astro dev",
    "prestart": "bun scripts/fetch-engine.ts",
    "start": "astro dev",
    "prebuild": "bun scripts/fetch-engine.ts",
    "build": "astro check && bun run lint && astro build && pagefind --site dist",
    "preview": "astro preview",
    "lint": "oxlint --type-aware --ignore-pattern \"src/generated/**\" src scripts",
    "format": "oxfmt --check src scripts",
    "astro": "astro",
    "fetch-engine": "bun scripts/fetch-engine.ts",
    "generate-photo-metadata": "bun scripts/generate-photo-metadata.ts",
    "rename-photos-sequential": "bun scripts/rename-photos-sequential.ts",
    "test": "bun test scripts",
    "election:update": "bun scripts/election-2027/update.ts",
    "format:write": "oxfmt src scripts",
    "roll-mapping:hash": "bun scripts/roll-mapping/cli.ts hash",
    "roll-mapping:verify": "bun scripts/roll-mapping/cli.ts verify"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource/metropolis": "5.2.5",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@playform/compress": "0.2.5",
    "@unpic/astro": "1.0.2",
    "astro": "7.2.8",
    "mdast-util-to-string": "4.0.0",
    "reading-time": "1.5.0",
    "typescript": "5.8.3",
    "unpic": "4.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "netlify-plugin-cache": "1.0.3",
    "node-html-parser": "9.0.4",
    "oxfmt": "0.24.0",
    "oxlint": "1.39.0",
    "oxlint-tsgolint": "0.11.1",
    "pagefind": "1.5.2",
    "sharp": "0.35.4"
  },
  "packageManager": "bun@1.3.6"
}
