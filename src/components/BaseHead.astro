---
import metropolis from "@fontsource/metropolis/files/metropolis-latin-400-normal.woff2?url";

export interface OpenGraphImage {
  url: string;
  width?: number;
  height?: number;
  alt?: string;
}

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article" | "profile";
  articleDate?: Date;
  ogImage?: OpenGraphImage;
}

const {
  title,
  description = "Theo Dammaretz online business card and resume homemade website and portfolio",
  ogType = "website",
  articleDate,
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage.url, Astro.site).href : undefined;

const jsonLd =
  ogType === "article" && articleDate
    ? {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        headline: title,
        datePublished: articleDate.toISOString(),
        author: {
          "@type": "Person",
          name: "Theo Dammaretz",
        },
        url: canonicalURL.href,
      }
    : {
        "@context": "http://schema.org",
        "@type": "WebSite",
        name: "Theo Dammaretz",
        url: "https://dammaretz.fr",
      };
---

<head>
  <meta charset="UTF-8" />
  <script
    type="application/ld+json"
    data-test="jsonld"
    is:inline
    set:html={JSON.stringify(jsonLd, null, 2)}
  />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Theo Dammaretz" />
  <meta name="theme-color" content="#fcfcf8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1c1c1c" media="(prefers-color-scheme: dark)" />
  <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
  <meta property="og:title" content={title} />
  <meta property="og:type" content={ogType === "article" ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:description" content={description} />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
  {ogImageURL && ogImage?.alt && <meta property="og:image:alt" content={ogImage.alt} />}
  {ogImageURL && ogImage?.width && <meta property="og:image:width" content={String(ogImage.width)} />}
  {ogImageURL && ogImage?.height && <meta property="og:image:height" content={String(ogImage.height)} />}
  <meta property="og:site_name" content="Theo Dammaretz" />
  {ogType === "profile" && <meta property="og:profile:first_name" content="Theo" />}
  {ogType === "profile" && <meta property="og:profile:last_name" content="Dammaretz" />}
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="author" href="/humans.txt" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.ico" />
  <link rel="alternate" type="application/rss+xml" title="Blog feed" href="/rss.xml" />
  <meta name="generator" content={Astro.generator} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" as="font" type="font/woff2" href={metropolis} crossorigin />
  <title>{title}</title>
</head>
