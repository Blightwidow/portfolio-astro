---
interface Props {
  backLink?: string;
}

const { backLink } = Astro.props;

const asPath = Astro.url.pathname;
const parent = backLink || asPath.split("/").slice(0, -1).join("/") || "/";

const isPhotography = asPath.startsWith("/photography");
const isBlog = asPath.startsWith("/blog");
const isTravel = asPath.startsWith("/travel");
const isSearch = asPath.startsWith("/search");
---

<header id="header" role="banner">
  <nav role="navigation">
    {asPath === "/" ? <h1>theo dammaretz</h1> : <a href={parent}>← back</a>}
    <ul>
      <li>
        <a href="/photography" class:list={[{ active: isPhotography }]} style={{ textDecoration: "none" }}>photography</a>
      </li>
      <li>
        <a href="/blog" class:list={[{ active: isBlog }]} style={{ textDecoration: "none" }}>blog</a>
      </li>
      <li>
        <a href="/travel" class:list={[{ active: isTravel }]} style={{ textDecoration: "none" }}>travel</a>
      </li>
      <li>
        <a href="/search" class:list={[{ active: isSearch }]} style={{ textDecoration: "none" }}>search</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  nav {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  ul {
    display: flex;
    flex-direction: row;
    list-style: none;
    opacity: 0.7;
    margin: 0;
  }

  li {
    margin: 0 0.5rem;
  }

  h1 {
    font-size: 1rem;
    font-weight: normal;
    margin: 0;
  }

  .active {
    text-decoration: underline !important;
    text-underline-offset: 0.3rem;
    opacity: 1;
  }
</style>
