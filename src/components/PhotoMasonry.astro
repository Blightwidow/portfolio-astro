---
import { Picture } from "astro:assets";
import Pagination from "./Pagination.astro";
import type { Page } from "astro";
import type { Photo } from "../utils/photography";
interface Props {
  photos: Photo[];
  page?: Page<Photo>;
}

const { photos, page } = Astro.props;
---

<div>
  {
    photos
      .filter((photo) => Boolean(photo.data.image?.src))
      .map((photo, index) => (
        <a href={`/photography/photo/${photo.id}`} aria-label={`View photo: ${photo.data.alt}`}>
          <Picture
            src={photo.data.image as ImageMetadata}
            formats={["webp", "avif"]}
            alt={photo.data.alt}
            widths={[300, 510]}
            quality={90}
            sizes={`(min-width: 750px) 300, 510px`}
            loading={index < 2 ? "eager" : "lazy"}
            decoding={index < 2 ? "sync" : "async"}
            fetchpriority={index < 2 ? "high" : "low"}
          />
        </a>
      ))
  }
  {page && <Pagination page={page} />}
</div>

<style>
  div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  img {
    break-inside: avoid;
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
    background: grey;
    object-fit: cover;
  }

  @media (min-width: 750px) {
    img {
      aspect-ratio: 1;
      width: 14rem;
    }
  }

  a {
    position: relative;
  }

  a::after {
    content: "";
    position: absolute;
    display: block;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.5));
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  a:hover::after {
    opacity: 1;
  }
</style>
