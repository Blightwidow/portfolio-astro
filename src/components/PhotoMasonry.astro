---
import { Picture } from "astro:assets";
import type { Photo } from "../utils/photography";
import { generatePlaceholders } from "../utils/photography";

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
const placeholders = await generatePlaceholders(photos);
---

<div class="masonry">
  {
    photos
      .filter((photo) => Boolean(photo.data.image?.src))
      .map((photo, index) => {
        const img = photo.data.image as ImageMetadata;
        const placeholder = placeholders.get(photo.id);
        return (
          <a
            href={`/photography/photo/${photo.id}`}
            aria-label={`View photo: ${photo.data.alt}`}
            class="photo-item"
            style={`aspect-ratio: ${img.width} / ${img.height}; background-image: url(${placeholder}); background-size: cover;`}
          >
            <Picture
              src={img}
              formats={["webp"]}
              alt={photo.data.alt}
              widths={[300, 510, 768]}
              quality={85}
              sizes="(min-width: 1100px) calc(25vw - 1rem), (min-width: 750px) calc(33vw - 1rem), 100vw"
              loading={index < 4 ? "eager" : "lazy"}
              decoding={index < 4 ? "sync" : "async"}
              fetchpriority={index < 4 ? "high" : "low"}
            />
          </a>
        );
      })
  }
</div>

<style>
  .masonry {
    columns: 1;
    column-gap: 1rem;
    max-width: 72rem;
    margin: 1rem auto;
  }

  @media (min-width: 750px) {
    .masonry {
      columns: 3;
    }
  }

  @media (min-width: 1100px) {
    .masonry {
      columns: 4;
    }
  }

  .photo-item {
    position: relative;
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0.5rem;
  }

  .photo-item::after {
    content: "";
    position: absolute;
    display: block;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.5));
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
    border-radius: 0.5rem;
  }

  .photo-item:hover::after {
    opacity: 1;
  }


</style>
