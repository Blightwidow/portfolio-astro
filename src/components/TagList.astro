---
interface Props {
  tags: { tag: string; count: number }[];
  /** Where a tag link points: the tag name is appended to this. */
  baseUrl: string;
  /** Link back to the unfiltered list, only rendered when a tag is active. */
  allUrl: string;
  allLabel: string;
  ariaLabel: string;
  activeTag?: string;
}

const { tags, baseUrl, allUrl, allLabel, ariaLabel, activeTag } = Astro.props;
---

<nav class="tag-list" aria-label={ariaLabel}>
  {activeTag && <a href={allUrl}>{allLabel}</a>}
  {
    tags.map(({ tag, count }) => (
      <a
        href={`${baseUrl}/${tag}`}
        class:list={[{ active: tag === activeTag }]}
        aria-current={tag === activeTag ? "page" : undefined}
      >
        #{tag} <span class="count">{count}</span>
      </a>
    ))
  }
</nav>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 2rem;
  }

  a {
    white-space: nowrap;
  }

  a.active {
    font-weight: 700;
  }

  .count {
    opacity: 0.6;
    font-size: 0.85em;
  }
</style>
