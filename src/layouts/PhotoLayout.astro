---
import Layout from "./Layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const asPath = Astro.url.pathname;
const backLink = asPath.includes("/photo/") ? "/photography" : undefined;
---

<Layout title={title} backLink={backLink} showFooter={false} constrainMain={false}>
  <slot />
</Layout>
