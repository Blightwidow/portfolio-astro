---
import "@fontsource/metropolis/400.css";
import "../styles/global.css";

import BaseHead from "../components/BaseHead.astro";
import type { OpenGraphImage } from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article" | "profile";
  articleDate?: Date;
  ogImage?: OpenGraphImage;
  backLink?: string;
  showFooter?: boolean;
  constrainMain?: boolean;
}

const {
  title,
  description,
  ogType,
  articleDate,
  ogImage,
  backLink,
  showFooter = true,
  constrainMain = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <BaseHead title={title} description={description} ogType={ogType} articleDate={articleDate} ogImage={ogImage} />
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header backLink={backLink} />
    <main id="main-content" class:list={[{ constrained: constrainMain }]}>
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }

  body {
    font-family: var(--main-font-family);
    letter-spacing: 0.03em;
    -webkit-font-smoothing: antialiased;
    color: rgb(var(--foreground-rgb));
    fill: rgb(var(--foreground-rgb));
    background: rgb(var(--background-rgb));
    padding: 1rem 1rem;
    line-height: 1.6;
  }

  @media (min-width: 550px) {
    body {
      padding: 2rem 1rem;
    }
  }

  main.constrained {
    max-width: 44rem;
    margin: 0 auto;
  }

  .skip-link {
    position: absolute;
    top: -50px;
    left: 6px;
    background: rgb(var(--background-rgb));
    color: rgb(var(--foreground-rgb));
    padding: 8px;
    text-decoration: none;
    border: 1px solid rgb(var(--foreground-rgb));
    z-index: 100;
    border-radius: 4px;
  }

  .skip-link:focus {
    top: 6px;
  }
</style>
