---
import type { PaginateFunction } from "astro";
import Pagination from "../../components/Pagination.astro";
import PostList from "../../components/PostList.astro";
import TagList from "../../components/TagList.astro";
import Layout from "../../layouts/Layout.astro";
import { getAllPostByDate, getAllTagsWithCounts } from "../../utils/blog";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = await getAllPostByDate("desc");

  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const tags = await getAllTagsWithCounts();
---

<Layout title="Blog - Theo Dammaretz" backLink="/">
  <h1>Blog</h1>
  <TagList tags={tags} baseUrl="/blog/tag" allUrl="/blog" allLabel="All posts" ariaLabel="Blog topics" />
  <PostList posts={page.data} />
  <Pagination page={page} baseUrl="/blog" />
</Layout>
