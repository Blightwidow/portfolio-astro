---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getAllPostByDate } from "../../utils/blog";
import { formatDate, toISODate } from "../../utils/date";

export async function getStaticPaths() {
  const posts = await getAllPostByDate("desc");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const readingTime = remarkPluginFrontmatter?.readingTime;
---

<Layout
  title={`${post.data.title} - Theo Dammaretz`}
  description={post.data.subtitle}
  ogType="article"
  articleDate={post.data.date}
  ogImage={{
    url: `/blog/og/${post.id}.png`,
    width: 1200,
    height: 630,
    alt: post.data.title,
  }}
>
  <article>
    <div class="meta">
      <time datetime={toISODate(post.data.date)}>{formatDate(post.data.date)}</time>
      {readingTime && <span class="reading-time">{readingTime}</span>}
    </div>
    <Content />
  </article>
</Layout>

<style>
  .meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .reading-time::before {
    content: "\b7";
    margin-right: 1rem;
  }
</style>
