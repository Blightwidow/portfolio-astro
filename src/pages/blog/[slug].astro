---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import { getAllPostByDate, getRelatedPosts, getSeriesNavigation } from "../../utils/blog";
import { formatDate, toISODate } from "../../utils/date";

export async function getStaticPaths() {
  const posts = await getAllPostByDate("desc");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const readingTime = remarkPluginFrontmatter?.readingTime;
const seriesNavigation = await getSeriesNavigation(post);
const tags = post.data.tags ?? [];
const relatedPosts = await getRelatedPosts(post);
---

<Layout
  title={`${post.data.title} - Theo Dammaretz`}
  description={post.data.subtitle}
  ogType="article"
  articleDate={post.data.date}
>
  <article data-pagefind-body>
    <div class="meta">
      <time datetime={toISODate(post.data.date)}>{formatDate(post.data.date)}</time>
      {readingTime && <span class="reading-time">{readingTime}</span>}
    </div>
    {seriesNavigation && <SeriesNav navigation={seriesNavigation} variant="header" />}
    <Content />
  </article>
  {
    tags.length > 0 && (
      <nav class="tags" aria-label="Post topics">
        {tags.map((tag) => (
          <a href={`/blog/tag/${tag}`}>#{tag}</a>
        ))}
      </nav>
    )
  }
  {seriesNavigation && <SeriesNav navigation={seriesNavigation} variant="footer" />}
  {
    relatedPosts.length > 0 && (
      <nav class="related" aria-labelledby="read-next">
        <h2 id="read-next">Read next</h2>
        <ul>
          {relatedPosts.map((relatedPost) => (
            <li>
              <a href={`/blog/${relatedPost.id}`}>{relatedPost.data.title}</a>
              {Boolean(relatedPost.data.subtitle) && <p>{relatedPost.data.subtitle}</p>}
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Layout>

<style>
  .meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .reading-time::before {
    content: "\b7";
    margin-right: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 3rem;
  }

  .tags a {
    white-space: nowrap;
  }

  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(var(--foreground-rgb), 0.15);
  }

  .related h2 {
    font-size: 1rem;
    opacity: 0.6;
    margin: 0 0 0.75rem;
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related p {
    margin: 0.1rem 0 0;
    opacity: 0.6;
    font-size: 0.9em;
  }
</style>
