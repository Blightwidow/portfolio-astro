---
import PhotoMasonry from "../../components/PhotoMasonry.astro";
import Layout from "../../layouts/Layout.astro";
import { getAllPostsByDate } from "../../utils/photography";

export async function getStaticPaths({ paginate }) {
  const photos = await getAllPostsByDate("desc");
  return paginate(photos, { pageSize: 30 });
}

const { page } = Astro.props;
---

<Layout title="Photography - Theo Dammaretz">
  <h1>Photography</h1>
  <p>
    I am trying to get back into photography, and more specifically film photography. As such, I will try to post a
    photo a day for the next year, as a way to push myself.
  </p>
  <p>Here are some of my favorite shots.</p>
  <PhotoMasonry photos={page.data} page={page} />
</Layout>
