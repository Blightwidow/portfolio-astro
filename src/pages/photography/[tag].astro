---
import PhotoMasonry from "../../components/PhotoMasonry.astro";
import Layout from "../../layouts/Layout.astro";
import { getAllPostsByDate, getAllTags } from "../../utils/photography";

export async function getStaticPaths() {
  const photos = await getAllPostsByDate("desc");
  const tags = await getAllTags();

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      photos: photos.filter((photo) => photo.data.tags?.includes(tag) ?? false),
    },
  }));
}

const { tag, photos } = Astro.props;
---

<Layout title={`Photography: #${tag} - Theo Dammaretz`}>
  <h1>#{tag}</h1>
  <PhotoMasonry photos={photos} />
</Layout>
