---
import PhotoMasonry from "../../components/PhotoMasonry.astro";
import TagList from "../../components/TagList.astro";
import Layout from "../../layouts/Layout.astro";
import { getAllPostsByDate, getAllTagsWithCounts } from "../../utils/photography";

export async function getStaticPaths() {
  const photos = await getAllPostsByDate("desc");
  const tags = await getAllTagsWithCounts();

  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      tags,
      photos: photos.filter((photo) => photo.data.tags?.includes(tag) ?? false),
    },
  }));
}

const { tag, tags, photos } = Astro.props;
---

<Layout title={`Photography: #${tag} - Theo Dammaretz`} constrainMain={false}>
  <div class="intro">
    <h1>#{tag}</h1>
    <TagList tags={tags} activeTag={tag} />
  </div>
  <PhotoMasonry photos={photos} />
</Layout>

<style>
  .intro {
    max-width: 44rem;
    margin: 0 auto;
  }
</style>
