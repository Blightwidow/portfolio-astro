---
import PhotoMasonry from "../../components/PhotoMasonry.astro";
import Layout from "../../layouts/Layout.astro";
import { getAllPostsByDate } from "../../utils/photography";

const photos = await getAllPostsByDate("desc");
---

<Layout title="Photography - Theo Dammaretz" backLink="/" constrainMain={false}>
  <div class="intro">
    <h1>Photography</h1>
    <p>
      This page was created to share some of my photos during a challenge I set for myself to take a photo every day for a year.
    </p>
    <p>
      The experiment is now over, but I will continue to share photos here as I take them.
    </p>
  </div>
  <PhotoMasonry photos={photos} />
</Layout>

<style>
  .intro {
    max-width: 44rem;
    margin: 0 auto 2rem;
  }
</style>
